# Supabase — copy this file to .env.local and fill in your values
# Get these from: https://supabase.com/dashboard → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Superfone webhook — optional secret to verify incoming POST requests
# SUPERFONE_WEBHOOK_SECRET=your-random-secret-here

# Optional: Phone OTP login via MSG91 (also configurable in Settings → Security)
# OTP_LOGIN_ENABLED=false
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
